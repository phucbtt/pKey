# Telex golden cases. Expected values come from Vietnamese orthography, not from engine output.
# Format: ID scheme [option=value ...] "keys" => "expected"   (see crates/ime-testing/src/golden.rs)

# --- basics (spec §6)
TX001 telex "tieengs " => "tiếng "
TX002 telex "ddawng " => "đăng "
TX003 telex "caay " => "cây "
TX004 telex "nguwowif " => "người "
TX005 telex "nguowif " => "người "
TX006 telex "quoocs " => "quốc "
TX007 telex "giaf " => "già "
TX008 telex "gif " => "gì "
TX009 telex "hoaf " => "hoà "
TX010 telex tone_style=traditional "hoaf " => "hòa "
TX011 telex "thuyr " => "thuỷ "
TX012 telex tone_style=traditional "thuyr " => "thủy "
TX013 telex "khuyeens " => "khuyến "
TX014 telex "ruwowuj " => "rượu "
TX015 telex "tuooir " => "tuổi "
TX016 telex "xoawn " => "xoăn "
TX017 telex "quow " => "quơ "
TX018 telex "khoer " => "khoẻ "
TX019 telex tone_style=traditional "khoer " => "khỏe "
TX020 telex "quys " => "quý "

# --- single vowels and tones
TX030 telex "as " => "á "
TX031 telex "af " => "à "
TX032 telex "ar " => "ả "
TX033 telex "ax " => "ã "
TX034 telex "aj " => "ạ "
TX035 telex "aaa " => "aa "
TX036 telex "ass " => "as "
TX037 telex "aww " => "aw "
TX038 telex "ddd " => "dd "
TX039 telex "ooo " => "oo "

# --- case
TX040 telex "DDAWNG " => "ĐĂNG "
TX041 telex "Ddawng " => "Đăng "
TX042 telex "dDawng " => "đăng "
TX043 telex "TIEENGS " => "TIẾNG "
TX044 telex "Vieetj " => "Việt "
TX045 telex "Vieetj Nam " => "Việt Nam "
TX046 telex "Nooij " => "Nội "
TX047 telex "Tuwj " => "Tự "

# --- more words
TX050 telex "ddi " => "đi "
TX051 telex "dduowng " => "đương "
TX052 telex "dduwowngf " => "đường "
TX053 telex "chaof " => "chào "
TX054 telex "muwngf " => "mừng "
TX055 telex "hocj " => "học "
TX056 telex "nhieeuf " => "nhiều "
TX057 telex "yeeu " => "yêu "
TX058 telex "yeeus " => "yếu "
TX059 telex "toois " => "tối "
TX060 telex "nuowcs " => "nước "
TX061 telex "bieenr " => "biển "
TX062 telex "ddieeuf " => "điều "
TX063 telex "khoong " => "không "
TX064 telex "ngoaif " => "ngoài "
TX065 telex "nghix " => "nghĩ "
TX066 telex "nghieeng " => "nghiêng "
TX067 telex "quyeets " => "quyết "
TX068 telex "giuwx " => "giữ "
TX069 telex "gieeng " => "giêng "
TX070 telex "thanhf " => "thành "
TX071 telex "ddoongf " => "đồng "
TX072 telex "uoongs " => "uống "
TX073 telex "quaan " => "quân "
TX074 telex "tw " => "tư "
TX075 telex "ww " => "w "

# --- not Vietnamese: stay as typed
TX080 telex "windows " => "windows "
TX081 telex "book " => "book "
TX082 telex "tapf " => "tapf "
TX083 telex "hocr " => "hocr "
TX084 telex "xin " => "xin "
TX085 telex "Hanoi " => "Hanoi "
TX086 telex "abc123 " => "abc123 "

# --- spell check off / auto restore off
TX090 telex spell_check=false "tiesng " => "tiéng "
TX091 telex "tiesng " => "tiesng "
TX092 telex auto_restore=false "book " => "bôk "

# --- backspace, escape, delimiters, focus
TX100 telex "tieengs{BS} " => "tiến "
TX101 telex backspace=raw "tieengs{BS} " => "tiêng "
TX102 telex "tieengs{ESC}" => "tieengs"
TX103 telex "aas{BS}x " => "x "
TX104 telex "xin chaof." => "xin chào."
TX105 telex "a,b" => "a,b"
TX106 telex "chaof{ENTER}" => "chào\n"
TX107 telex "tieengs{FOCUSOUT}" => "tiếng"
TX108 telex "tieengs{LEFT}x" => "tiếngx"
TX109 telex "tieengs{HOSTCANCEL}x" => "x"
TX110 telex focus_commit=false "tieengs{FOCUSOUT}" => ""
TX111 telex restore_key=none "tieengs{ESC}" => "tiếng"
TX112 telex "{BS}" => ""
TX113 telex "abc{LBRACE}x " => "abc{x "

# --- output form
TX120 telex output=nfd "tieengs " => "tie\u{0302}\u{0301}ng "

# Regression: open `uơ` (the `uow` shortcut first makes `ươ`) and `oeo` (the second o must not
# become a circumflex on the first one).
TX900 telex "thuowr " => "thuở "
TX901 telex "huow " => "huơ "
TX902 telex "khoeof " => "khoèo "
TX903 telex "ngoeoj " => "ngoẹo "
TX904 telex "huowu " => "hươu "
TX905 telex "thuowng " => "thương "
